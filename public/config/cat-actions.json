{
  "description": "煤球的动作库。每个动作：trigger 什么时候触发、where 在哪儿能做、when 条件、weight 权重（再乘 moodWeight 心情 / phaseWeight 作息 / activityLevelWeight 活跃度 / mischiefLevelWeight 捣乱程度的系数）、cooldownSeconds 冷却、maxPerHour 每小时最多几次、steps 步骤。完整说明见 docs/动作系统说明.md。用户覆盖：%APPDATA%\\com.meiqiu.waterpet\\config\\cat-actions.json（同 id 替换，disabled: true 关掉，新 id 追加）",

  "selection": {"description": "刚做过的动作分数打折（noveltyPenalty），过 noveltySeconds 秒后基本恢复，避免同一个动作连着重复", "noveltyPenalty": 0.6, "noveltySeconds": 90},

  "actions": [
    {"id": "wander", "name": "溜达", "trigger": "idle", "where": ["floor", "edge"], "weight": 45, "activityLevelWeight": {"calm": 0.5, "lively": 1.5}, "moodWeight": {"happy": 1.2, "grumpy": 0.6, "angry": 0.5}, "phaseWeight": {"lunch": 0.2, "afternoonSlump": 0.7, "almostOff": 1.5, "overtime": 0.7, "offDay": 0.8}, "steps": [{"run": "wander"}]},
    {"id": "peek", "name": "偷看你在干嘛", "trigger": "idle", "where": ["floor", "edge"], "when": {"fullscreen": false}, "weight": 12, "activityLevelWeight": {"calm": 0.6, "lively": 1.3}, "phaseWeight": {"lunch": 0.2}, "cooldownSeconds": 40, "steps": [{"run": "peek"}]},
    {"id": "peek-edge", "name": "在底边时偷看", "trigger": "idle", "where": ["edge"], "when": {"fullscreen": false}, "weight": 15, "phaseWeight": {"lunch": 0.2}, "cooldownSeconds": 40, "steps": [{"run": "peek"}]},
    {"id": "peek-fullscreen", "name": "全屏时躲起来只露脑袋", "trigger": "idle", "where": ["floor", "edge"], "when": {"fullscreen": true}, "weight": 50, "steps": [{"run": "peek"}]},
    {"id": "patrol", "name": "跳上窗口巡视", "trigger": "idle", "where": ["floor", "edge"], "when": {"roamMode": ["free"], "lowProfile": false}, "weight": 25, "activityLevelWeight": {"calm": 0.6, "lively": 1.3}, "phaseWeight": {"lunch": 0, "almostOff": 1.3, "overtime": 0.6}, "cooldownSeconds": 20, "steps": [{"run": "patrol"}]},
    {"id": "approach-cursor", "name": "凑过来求关注", "trigger": "idle", "where": ["floor"], "when": {"quietMinutesAtLeast": 20, "lowProfile": false}, "weight": 8, "moodWeight": {"happy": 1.5, "grumpy": 0.3, "angry": 0}, "cooldownSeconds": 600, "maxPerHour": 2, "steps": [{"run": "approachCursor", "text": ["陪本喵玩一会儿嘛～", "你都好久没理本喵了…", "看看本喵嘛～"]}]},
    {"id": "go-edge-nap", "name": "去屏幕边上找地方打盹", "trigger": "idle", "where": ["floor"], "weight": 1, "phaseWeight": {"lunch": 8, "afternoonSlump": 2, "overtime": 1.5}, "cooldownSeconds": 600, "steps": [{"run": "goEdge"}]},
    {"id": "mischief-zoomies", "name": "满屏乱跑", "trigger": "idle", "where": ["floor"], "when": {"mischiefLevel": ["sometimes", "often"], "lowProfile": false, "roamMode": ["free"]}, "weight": 2.5, "mischiefLevelWeight": {"sometimes": 1, "often": 3}, "moodWeight": {"happy": 1.4, "angry": 1.2}, "phaseWeight": {"lunch": 0, "almostOff": 1.8, "afternoonSlump": 0.6}, "cooldownSeconds": 120, "maxPerHour": 3, "steps": [{"run": "mischief:zoomies"}]},
    {"id": "mischief-pounce", "name": "扑你的鼠标", "trigger": "idle", "where": ["floor"], "when": {"mischiefLevel": ["sometimes", "often"], "lowProfile": false, "roamMode": ["free"], "cursorNearby": true}, "weight": 2, "mischiefLevelWeight": {"sometimes": 1, "often": 3}, "moodWeight": {"happy": 1.4}, "phaseWeight": {"lunch": 0}, "cooldownSeconds": 90, "steps": [{"run": "mischief:pounce"}]},
    {"id": "mischief-occupy-window", "name": "霸占你的窗口", "trigger": "idle", "where": ["floor", "window"], "when": {"mischiefLevel": ["sometimes", "often"], "lowProfile": false, "roamMode": ["free"]}, "weight": 1.2, "mischiefLevelWeight": {"sometimes": 1, "often": 3}, "moodWeight": {"angry": 1.5}, "phaseWeight": {"lunch": 0}, "cooldownSeconds": 300, "maxPerHour": 2, "steps": [{"run": "mischief:occupyWindow"}]},
    {"id": "mischief-push-cup", "name": "把小杯子推下去", "trigger": "idle", "where": ["floor", "window"], "when": {"mischiefLevel": ["sometimes", "often"], "lowProfile": false, "roamMode": ["free"], "hasLegs": true}, "weight": 1, "mischiefLevelWeight": {"sometimes": 1, "often": 3}, "moodWeight": {"grumpy": 1.5, "angry": 2}, "phaseWeight": {"lunch": 0}, "cooldownSeconds": 300, "maxPerHour": 2, "steps": [{"run": "mischief:pushCup"}]},
    {"id": "mischief-follow", "name": "跟在鼠标后面", "trigger": "idle", "where": ["floor"], "when": {"mischiefLevel": ["sometimes", "often"], "lowProfile": false, "roamMode": ["free"]}, "weight": 1, "mischiefLevelWeight": {"sometimes": 1, "often": 3}, "moodWeight": {"happy": 1.5, "angry": 0.3}, "phaseWeight": {"lunch": 0}, "cooldownSeconds": 180, "steps": [{"run": "mischief:follow"}]},
    {"id": "sit", "name": "坐一会儿", "trigger": "idle", "weight": 30, "steps": [{"pose": "sit", "seconds": [3, 6]}]},
