    {"id": "rest", "name": "趴下休息", "trigger": "idle", "weight": 14, "activityLevelWeight": {"calm": 1.5, "lively": 0.6}, "phaseWeight": {"lunch": 4, "afternoonSlump": 2, "overtime": 2, "offDay": 2}, "steps": [{"pose": "rest", "seconds": [5, 9]}]},
    {"id": "loaf", "name": "揣手手（母鸡蹲）", "trigger": "idle", "weight": 8, "activityLevelWeight": {"calm": 1.5}, "phaseWeight": {"afternoonSlump": 1.5, "offDay": 1.5}, "steps": [{"pose": "rest", "seconds": [6, 10], "face": "user", "tweak": {"legKick": 0, "tailWrap": 1, "squint": 0.5, "eyeOpen": 0.6}}]},
