    {"id": "sleepy-nod", "name": "打瞌睡点头", "trigger": "idle", "weight": 2, "phaseWeight": {"afternoonSlump": 4, "lunch": 3, "overtime": 3, "morning": 1.5, "working": 0.6}, "steps": [{"pose": "sit", "seconds": [3, 5], "tweak": {"eyeOpen": 0.25}, "animate": {"headPitch": {"amplitude": 0.25, "speed": 2.2}}, "float": "z"}]},
    {"id": "happy-hop", "name": "开心地蹦一下", "trigger": ["idle", "trick"], "weight": 1, "moodWeight": {"happy": 4, "grumpy": 0.2, "angry": 0}, "phaseWeight": {"almostOff": 12}, "steps": [{"pose": "happy", "seconds": 1.6, "float": ["♪", "✨", "♡"]}]},
    {"id": "roll", "name": "打滚", "trigger": ["idle", "trick"], "when": {"mood": ["happy"]}, "weight": 2, "cooldownSeconds": 60, "steps": [{"run": "roll"}]},
