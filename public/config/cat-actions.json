    {"id": "stand-look-around", "name": "站着东张西望", "trigger": "idle", "weight": 6, "steps": [{"pose": "stand", "seconds": [2, 4], "animate": {"headYaw": {"amplitude": 0.7, "speed": 1.6}}, "tweak": {"earPerk": 0.8}}]},
    {"id": "look-around", "name": "坐着东张西望", "trigger": "idle", "weight": 5, "steps": [{"pose": "sit", "seconds": [3, 5], "animate": {"headYaw": {"amplitude": 0.9, "speed": 1.4}}, "tweak": {"earPerk": 0.8}}]},
    {"id": "groom", "name": "舔爪子洗脸", "trigger": "idle", "weight": 14, "phaseWeight": {"morning": 1.5}, "steps": [{"pose": "groom", "seconds": [3, 5]}], "when": {"hasLegs": true}},
